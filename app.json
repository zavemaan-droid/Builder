{
  "expo": {
    "name": "AI Builder",
    "slug": "ai-builder-platform",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "aibuilder",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aibuilder.app"
    },
    "android": {
      "package": "com.aibuilder.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "AI Builder Platform",
      "shortName": "AI Builder",
      "description": "Build and deploy AI-powered applications",
      "themeColor": "#6366f1",
      "backgroundColor": "#0a0a0f",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "scope": "/",
      "lang": "en"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
